    "ambiguous": [
      "yeast extract",
      "hydrolyzed vegetable protein",
      "hvp",
      "soy sauce powder",
      "sodium bicarbonate",
      "baking soda",
      "disodium phosphate",
      "sodium benzoate"
    ],
    "allowed_exceptions": [
      "potassium chloride"
    ]
  }
