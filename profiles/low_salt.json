  "voice_quote": "Converting grams of salt to milligrams of doom.",
  "rule_type": "both",
  "limits": {
    "sodium_per_serving_max_mg": 400.0,
    "sodium_per_pack_max_mg": 1000.0,
    "sodium_per_100g_max_mg": 600.0,
    "sodium_warning_serving_mg": 250.0
